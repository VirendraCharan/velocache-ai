# Copy this file to .env, then fill in the three empty values below.
# .env is ignored by Git, so your real values are never committed.

# Password for the MySQL user the app uses (any text you like).
MYSQL_PASSWORD=

# The key you type on the dashboard's "Staff login" screen.
VELOCACHE_OPS_KEY=

# Signs login tokens. Use at least 32 random characters, or the app refuses to start.
VELOCACHE_JWT_SECRET=

# Optional: how long a cached entry lives, in seconds (default 120). A benchmark can raise it.
# VELOCACHE_CACHE_SHELF_LIFE_SECONDS=120

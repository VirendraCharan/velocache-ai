spring.application.name=middleware
server.port=8080
spring.datasource.url=jdbc:mysql://localhost:3306/velocache_db
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.data.redis.host=localhost
spring.data.redis.port=6379
management.endpoints.web.exposure.include=health,metrics
velocache.dev-token-secret=change-me
velocache.ops-key=CHANGE_ME

# Optional settings. Each line below is commented out and shows the built-in default. Uncomment a line only to change it.
# Cache warming on or off. Default: true.
# velocache.warming.enabled=true
# Automated demo traffic for one demo tenant (a burst every 5 minutes). Default: false.
# velocache.demo-rhythm.enabled=false
# Name of the automated demo tenant. Default: demo-rhythm.
# velocache.demo-rhythm.tenant=demo-rhythm
# Tenants that the public read-only demo may show. Comma separated. Default: demo-a,demo-b.
# velocache.demo-tenants=demo-a,demo-b
# The one browser origin allowed to call the API. Default: http://localhost:5173.
# velocache.cors.allowed-origin=http://localhost:5173
# Key that signs login tokens. At least 32 characters or the app refuses to start. If left unset, a random key is used and every restart invalidates all tokens.
# velocache.jwt-secret=